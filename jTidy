#!/usr/bin/env bash
#	jTidy 3.3
#	Audit the macOS home directory and guide an interactive cleanup
#	Dependencies: fzf, brew, du, df, find
#	Keywords: cleanup, organize, home directory, dotfiles, audit, declutter
#	Usage: jTidy
#
#	By Joris van Dijk | Jorisvandijk.com
#	Licensed under the MIT license

source "$(dirname "${BASH_SOURCE[0]}")/j"

[[ "$1" == "--version" || "$1" == "-v" ]] && j::version "$0" && exit 0
[[ "$1" == "--help"    || "$1" == "-h" ]] && j::help "jTidy" && exit 0
[[ -n "$1" ]]                             && j::die "Usage: jTidy (no arguments)"

[[ "$(j::os)" == "macos" ]] || j::die "This script only supports macOS"

j::require brew du df find

_avail_bytes() { df -k / | awk 'NR==2 {print $4 * 1024}'; }
_home_bytes()  { du -sk ~ 2>/dev/null | awk '{print $1 * 1024}'; }

_bytes_hr() {
    awk -v bytes="$1" 'BEGIN {
        if (bytes >= 1099511627776) printf "%.1fT", bytes/1099511627776
        else if (bytes >= 1073741824) printf "%.2fG", bytes/1073741824
        else if (bytes >= 1048576)    printf "%.1fM", bytes/1048576
        else if (bytes >= 1024)       printf "%.1fK", bytes/1024
        else                          printf "%dB", bytes
    }'
}

_fzf_pick() {
    local prompt="$1"
    j::pick_table "$prompt" "1,2" multi \
        'target={2}; if [[ -d "$target" ]]; then ls -lah "$target" 2>/dev/null | head -30; else file "$target" 2>/dev/null; fi'
}

_baseline() {
    j::msg ""; j::msg "${J_BOLD}${J_CYAN}━━━ BASELINE ━━━${J_RESET}"
    df -h / | awk 'NR<=2'
    j::msg "Home total: ${J_BOLD}$(_bytes_hr "$BEFORE_HOME")${J_RESET}"
}

_report_sizes() {
    local title="$1" count="$2"; shift 2
    j::msg ""; j::msg "${J_BOLD}${J_CYAN}━━━ $title ━━━${J_RESET}"
    du -sh "$@" 2>/dev/null | sort -hr | head -"$count"
}

_installed_names() {
    local out
    out=$(
        brew list --formula 2>/dev/null
        brew list --cask 2>/dev/null
        ls /Applications 2>/dev/null | sed 's/\.app$//'
        ls ~/.local/bin 2>/dev/null
        ls ~/.local/share 2>/dev/null
    )
    printf '%s\n' "${out,,}"
}

_format_config_entry() {
    local dir="$1" haystack="$2"
    local name size lower
    name="${dir%/}"; name="${name##*/}"
    size=$(du -sh "$dir" 2>/dev/null | awk '{print $1}')
    lower="${name,,}"
    if grep -qi -- "^${lower}\(-\|_\|$\)" <<< "$haystack"; then
        printf "  %-28s %-8s ${J_GREEN}installed${J_RESET}\n" "$name" "$size"
    else
        printf "  %-28s %-8s ${J_YELLOW}ORPHAN?${J_RESET}\n" "$name" "$size"
    fi
}

_report_config_cross_reference() {
    local haystack="$1" dir
    j::msg ""; j::msg "${J_BOLD}${J_CYAN}━━━ ~/.config CROSS-REFERENCE ━━━${J_RESET}"
    printf "  %-28s %-8s %s\n" "CONFIG" "SIZE" "STATUS"
    for dir in ~/.config/*/; do
        [[ -e "$dir" ]] || continue
        _format_config_entry "$dir" "$haystack"
    done
}

_collect_orphan_configs() {
    local haystack="$1" dir name lower
    for dir in ~/.config/*/; do
        [[ -e "$dir" ]] || continue
        name="${dir%/}"; name="${name##*/}"
        lower="${name,,}"
        grep -qi -- "^${lower}\(-\|_\|$\)" <<< "$haystack" && continue
        ORPHAN_CONFIGS+=("$dir")
    done
}

_collect_snapshots() {
    mapfile -t SNAPSHOT_NAMES < <(tmutil listlocalsnapshots / 2>/dev/null \
        | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{6}' || true)
}

_report_snapshots() {
    j::msg ""; j::msg "${J_BOLD}${J_CYAN}━━━ TIME MACHINE SNAPSHOTS ━━━${J_RESET}"
    [[ ${#SNAPSHOT_NAMES[@]} -gt 0 ]] || { j::msg "  none"; return; }
    printf '  %s\n' "${SNAPSHOT_NAMES[@]}"
}

_delete_selected() {
    local size path
    while IFS=$'\t' read -r size path; do
        [[ -n "$path" && -e "$path" ]] || continue
        rm -rf "$path" 2>/dev/null && { j::msg "${J_GREEN}✓ Removed ($size): $path${J_RESET}"; continue; }
        j::msg "${J_RED}✗ Failed:  $path${J_RESET}"
    done
}

_maybe_remove_dotfiles_entry() {
    local name="$1"
    local repo_path="$HOME/git/macbook/$name"
    [[ -e "$repo_path" ]] || return
    j::confirm "Also remove dotfiles repo entry $repo_path?" N || return
    rm -rf "$repo_path" && j::msg "${J_GREEN}✓ Removed: $repo_path${J_RESET}"
}

_delete_orphan_config() {
    local size path
    while IFS=$'\t' read -r size path; do
        [[ -n "$path" && -e "$path" ]] || continue
        rm -rf "$path" && j::msg "${J_GREEN}✓ Removed ($size): $path${J_RESET}"
        _maybe_remove_dotfiles_entry "${path##*/}"
    done
}

_delete_snapshots() {
    local snapshot
    while read -r snapshot; do
        [[ -n "$snapshot" ]] || continue
        sudo tmutil deletelocalsnapshots "$snapshot" && { j::msg "${J_GREEN}✓ Deleted: $snapshot${J_RESET}"; continue; }
        j::msg "${J_RED}✗ Failed:  $snapshot${J_RESET}"
    done
}

_review_and_delete() {
    local selected="$1" prompt="$2" deleter="${3:-_delete_selected}"
    [[ -n "$selected" ]] || { j::msg "${J_DIM}Skipped.${J_RESET}"; return; }
    j::msg ""
    j::msg "${J_BOLD}Marked for removal:${J_RESET}"
    j::msg "$selected"
    j::confirm "$prompt" N || return
    printf '%s\n' "$selected" | "$deleter"
}

_safe_item_sizes() {
    local item bytes safe_total=0
    for item in "$@"; do
        [[ -e "$item" ]] || continue
        bytes=$(du -sk "$item" 2>/dev/null | awk '{print $1 * 1024}')
        printf "  %-45s %s\n" "$item" "$(_bytes_hr "$bytes")"
        safe_total=$((safe_total + bytes))
    done
    j::msg "  ${J_BOLD}Reclaimable: ${J_GREEN}$(_bytes_hr "$safe_total")${J_RESET}"
}

_purge_dirs() {
    local item
    for item in "$@"; do
        [[ -d "$item" ]] || continue
        j::msg "  Emptying $item..."
        find "$item" -mindepth 1 -maxdepth 1 -exec rm -rf {} + 2>/dev/null
    done
}

_purge_files() {
    local item
    for item in "$@"; do
        [[ -e "$item" ]] && rm -f "$item"
    done
}

_phase_safe_items() {
    j::msg ""; j::msg "${J_BOLD}${J_CYAN}━━━ PHASE 1 — Always-safe items ━━━${J_RESET}"
    local safe_dirs=( "$HOME/.Trash" "$HOME/.cache" "$HOME/.zsh_sessions" "$HOME/.zcompcache" )
    local safe_files=( "$HOME/.DS_Store" )
    shopt -s nullglob
    safe_files+=( "$HOME"/.zcompdump-* )
    shopt -u nullglob

    _safe_item_sizes "${safe_dirs[@]}" "${safe_files[@]}"
    j::confirm "Clear all Phase 1 items?" N || return
    _purge_dirs "${safe_dirs[@]}"
    _purge_files "${safe_files[@]}"
    j::msg "${J_GREEN}✓ Phase 1 complete.${J_RESET}"
}

_phase_homebrew() {
    j::msg ""; j::msg "${J_BOLD}${J_CYAN}━━━ PHASE 2 — Homebrew cleanup ━━━${J_RESET}"
    j::msg "  Runs: brew autoremove && brew cleanup --prune=all"
    j::confirm "Proceed?" N || return
    brew autoremove
    brew cleanup --prune=all
    j::msg "${J_GREEN}✓ Phase 2 complete.${J_RESET}"
}

_phase_caches() {
    j::msg ""; j::msg "${J_BOLD}${J_CYAN}━━━ PHASE 3 — ~/Library/Caches (multi-select) ━━━${J_RESET}"
    j::msg "${J_DIM}TAB to mark, ENTER to confirm, ESC to skip.${J_RESET}"
    local selected
    selected=$(du -sh ~/Library/Caches/* 2>/dev/null | sort -hr | head -20 |
        _fzf_pick "Cache")
    _review_and_delete "$selected" "Delete these?"
}

_phase_app_support() {
    j::msg ""; j::msg "${J_BOLD}${J_CYAN}━━━ PHASE 4 — Application Support + Containers ━━━${J_RESET}"
    j::warn "These may contain game saves, app data, VM disks, wine bottles."
    j::warn "Removing is DESTRUCTIVE — consider Pearcleaner for app-associated removal."
    j::msg ""
    local selected
    selected=$(
        {
            du -sh ~/Library/Application\ Support/* 2>/dev/null | sort -hr | head -15
            du -sh ~/Library/Containers/*           2>/dev/null | sort -hr | head -10
        } | sort -hr |
        _fzf_pick "App Support"
    )
    _review_and_delete "$selected" "${J_RED}REALLY delete these?${J_RESET}"
}

_phase_orphan_configs() {
    j::msg ""; j::msg "${J_BOLD}${J_CYAN}━━━ PHASE 5 — Orphan ~/.config entries ━━━${J_RESET}"
    [[ ${#ORPHAN_CONFIGS[@]} -gt 0 ]] || { j::msg "${J_GREEN}✓ No orphan configs detected.${J_RESET}"; return; }
    local dir size orphan_list="" selected
    for dir in "${ORPHAN_CONFIGS[@]}"; do
        dir="${dir%/}"
        size=$(du -sh "$dir" 2>/dev/null | awk '{print $1}')
        orphan_list+="${size}"$'\t'"${dir}"$'\n'
    done
    selected=$(printf '%s' "$orphan_list" | _fzf_pick "Orphans")
    _review_and_delete "$selected" "Delete these?" _delete_orphan_config
}

_phase_snapshots() {
    [[ ${#SNAPSHOT_NAMES[@]} -gt 0 ]] || return
    j::msg ""; j::msg "${J_BOLD}${J_CYAN}━━━ PHASE 6 — Time Machine local snapshots ━━━${J_RESET}"
    j::warn "Deletion requires sudo."
    local selected
    selected=$(printf '%s\n' "${SNAPSHOT_NAMES[@]}" | j::pick "Snapshots" multi)
    [[ -n "$selected" ]] || { j::msg "${J_DIM}Skipped.${J_RESET}"; return; }
    j::confirm "Delete selected snapshots (sudo)?" N || return
    printf '%s\n' "$selected" | _delete_snapshots
}

_results() {
    j::msg ""; j::msg "${J_BOLD}${J_CYAN}━━━ RESULTS ━━━${J_RESET}"
    local after_avail after_home home_freed disk_freed
    after_avail=$(_avail_bytes)
    after_home=$(_home_bytes)
    home_freed=$((BEFORE_HOME - after_home))
    disk_freed=$((after_avail - BEFORE_AVAIL))
    printf "  %-18s %10s → %10s   ${J_GREEN}%s reclaimed${J_RESET}\n" \
        "Home size" "$(_bytes_hr "$BEFORE_HOME")" "$(_bytes_hr "$after_home")" "$(_bytes_hr "$home_freed")"
    printf "  %-18s %10s → %10s   ${J_GREEN}%s freed${J_RESET}\n" \
        "Disk available" "$(_bytes_hr "$BEFORE_AVAIL")" "$(_bytes_hr "$after_avail")" "$(_bytes_hr "$disk_freed")"
    j::msg ""
    j::info "Done"
}

declare -a ORPHAN_CONFIGS=()
declare -a SNAPSHOT_NAMES=()
BEFORE_AVAIL=$(_avail_bytes)
BEFORE_HOME=$(_home_bytes)

_baseline
_report_sizes "TOP-LEVEL ~ (visible)" 10 ~/*
_report_sizes "HIDDEN FILES IN ~" 15 ~/.??*
j::msg "${J_DIM}0B entries are usually Stow symlinks to ~/git/macbook/.${J_RESET}"
_report_sizes "~/Library/Application Support (top 15)" 15 ~/Library/Application\ Support/*
_report_sizes "~/Library/Containers (top 10)" 10 ~/Library/Containers/*
_report_sizes "~/Library/Caches (top 15)" 15 ~/Library/Caches/*
HAYSTACK=$(_installed_names)
_report_config_cross_reference "$HAYSTACK"
_collect_orphan_configs "$HAYSTACK"
_collect_snapshots
_report_snapshots

j::msg ""
j::confirm "Continue to cleanup phase?" N || { j::msg "${J_GREEN}✓ Audit only - no changes made.${J_RESET}"; exit 0; }

_phase_safe_items
_phase_homebrew
_phase_caches
_phase_app_support
_phase_orphan_configs
_phase_snapshots

_results
