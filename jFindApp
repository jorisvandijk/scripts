#!/usr/bin/env bash
#	jFindApp 4.0
#	Search for an app across App Store, Homebrew, and Nix
#	Dependencies: mas, brew, nix
#	Keywords: install, search, find, application, app store, homebrew, software
#	Usage: jFindApp <name>
#
#	By Joris van Dijk | Jorisvandijk.com
#	Licensed under the MIT license

source "$(dirname "${BASH_SOURCE[0]}")/j"

[[ "$1" == "--version" || "$1" == "-v" ]] && j::version "$0" && exit 0
[[ "$1" == "--help"    || "$1" == "-h" ]] && j::help "jFindApp" && exit 0
[[ -z "$1" ]] && j::die "Usage: jFindApp <name>"

j::require mas brew nix awk grep head sed sort

QUERY="$1"

_classify_match() {
    local all_names="$1"
    local exact close
    exact=$(grep -ix "$QUERY" <<< "$all_names")
    close=$(grep -i "$QUERY" <<< "$all_names" \
        | grep -vix "$QUERY" \
        | head -5 \
        | awk 'NR>1{printf ", "}{printf "%s",$0}END{if(NR>0)printf "\n"}')
    printf '%s\t%s' "$exact" "$close"
}

_format_result() {
    local label="$1" all_names="$2"
    local exact close
    IFS=$'\t' read -r exact close <<< "$(_classify_match "$all_names")"
    case "${exact:+e}${close:+c}" in
        ec) j::row "$J_GREEN"  "$label" "${exact}  ${close}" ;;
        e)  j::row "$J_GREEN"  "$label" "$exact" ;;
        c)  j::row "$J_YELLOW" "$label" "$close" ;;
        *)  j::row "$J_RED"    "$label" "not found" ;;
    esac
}

_search_appstore() {
    local all_names
    all_names=$(mas search "$QUERY" 2>/dev/null | awk '{
        sub(/^[[:space:]]*[0-9]+[[:space:]]+/, "")
        sub(/[[:space:]]+\([^)]+\)$/, "")
        if (NF > 0) print
    }')
    _format_result "App Store" "$all_names"
}

_search_homebrew() {
    local all_names
    all_names=$(brew search "$QUERY" 2>/dev/null \
        | grep -v '^==>' \
        | grep -v '^$' \
        | grep -v '^No formula')
    _format_result "Homebrew" "$all_names"
}

_nix_is_supported() {
    local name="$1"
    local result
    result=$(nix eval "nixpkgs#${name}.meta.unsupported" 2>/dev/null)
    [[ "$result" != "true" ]]
}

_nix_filter_supported() {
    local name
    while IFS= read -r name; do
        [[ -z "$name" ]] && continue
        _nix_is_supported "$name" && printf '%s\n' "$name"
    done
}

_search_nix() {
    local arch all_names
    local cpu="${MACHTYPE%%-*}"
    arch="${cpu/arm64/aarch64}-darwin"
    all_names=$(nix search nixpkgs "$QUERY" 2>/dev/null \
        | sed 's/\x1b\[[0-9;]*m//g' \
        | grep "^\* legacyPackages\.${arch}\." \
        | awk '{n=$2; sub(/.*\./, "", n); print n}' \
        | _nix_filter_supported \
        | sort -u)
    _format_result "Nix" "$all_names"
}

j::info "Results for: ${QUERY}"
j::msg ""
_search_appstore
_search_homebrew
_search_nix
