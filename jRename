#!/usr/bin/env bash
#	jRename 4.1
#	Rename files in current directory: lowercase, spaces and underscores to hyphens
#	Dependencies: none
#	Keywords: rename, lowercase, label, new name, hyphen, underscore
#	Usage: jRename
#
#	By Joris van Dijk | Jorisvandijk.com
#	Licensed under the MIT license

source "$(dirname "${BASH_SOURCE[0]}")/j"

[[ "$1" == "--version" || "$1" == "-v" ]] && j::version "$0" && exit 0
[[ "$1" == "--help"    || "$1" == "-h" ]] && j::help "jRename" && exit 0
[[ -n "$1" ]]                             && j::die "Usage: jRename (no arguments)"

j::require mv

_process_files() {
    local file lowercased candidate
    local changed=0
    for file in *; do
        [[ -f "$file" || -d "$file" ]] || continue
        lowercased="${file,,}"
        candidate="${lowercased// /-}"
        candidate="${candidate//_/-}"

        [[ "$candidate" == "$file" ]] && continue
        [[ -e "$candidate" && ! "$file" -ef "$candidate" ]] && { j::warn "Skipping '$file': '$candidate' already exists"; continue; }
        mv -- "$file" "$candidate"
        j::info "Renamed: '$file' → '$candidate'"
        changed=$(( changed + 1 ))
    done
    [[ $changed -eq 0 ]] && j::info "No files needed renaming"
}

_process_files
