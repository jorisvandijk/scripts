#!/usr/bin/env bash
#	jRepos 3.1
#	Show git status of all repositories in ~/git
#	Dependencies: git
#	Keywords: git status, repositories, overview, dirty, branches
#	Usage: jRepos
#
#	By Joris van Dijk | Jorisvandijk.com
#	Licensed under the MIT license

source "$(dirname "${BASH_SOURCE[0]}")/j"

[[ "$1" == "--version" || "$1" == "-v" ]] && j::version "$0" && exit 0
[[ "$1" == "--help"    || "$1" == "-h" ]] && j::help "jRepos" && exit 0
[[ -n "$1" ]]                             && j::die "Usage: jRepos (no arguments)"

j::require git

GIT_BASE_DIR="${HOME}/git"

_count_states() {
    local line index_status work_status
    local conflicted=0 staged=0 modified=0 untracked=0
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        index_status="${line:0:1}" work_status="${line:1:1}"
        [[ "$index_status" == "U" || "$work_status" == "U" || "$index_status$work_status" == "AA" || "$index_status$work_status" == "DD" ]] && { conflicted=$((conflicted + 1)); continue; }
        [[ "$index_status" == [MADRC] ]] && staged=$((staged + 1))
        [[ "$work_status" == "M" ]]      && modified=$((modified + 1))
        [[ "$index_status$work_status" == "??" ]] && untracked=$((untracked + 1))
    done
    printf '%s\n' "$conflicted|$staged|$modified|$untracked"
}

_build_label() {
    local conflicted="$1" staged="$2" modified="$3" untracked="$4" ahead="$5" behind="$6"
    local parts=()
    [[ "$conflicted" -gt 0 ]] && parts+=("$conflicted conflicted")
    [[ "$staged"     -gt 0 ]] && parts+=("$staged staged")
    [[ "$modified"   -gt 0 ]] && parts+=("$modified modified")
    [[ "$untracked"  -gt 0 ]] && parts+=("$untracked untracked")
    [[ "$ahead"      -gt 0 ]] && parts+=("ahead $ahead")
    [[ "$behind"     -gt 0 ]] && parts+=("behind $behind")
    printf '%s\n' "${parts[*]:-clean}"
}

_classify() {
    local conflicted="$1" staged="$2" modified="$3" untracked="$4" ahead="$5" behind="$6"
    [[ "$conflicted" -gt 0 ]]                                        && printf 'conflict\n' && return
    [[ "$ahead" -gt 0 || "$behind" -gt 0 ]]                          && printf 'sync\n'     && return
    [[ "$staged" -gt 0 || "$modified" -gt 0 || "$untracked" -gt 0 ]] && printf 'dirty\n'    && return
    printf 'clean\n'
}

_print_group() {
    local color="$1"; shift
    local entry
    for entry in "$@"; do
        j::row "$color" "${entry%|*}" "${entry#*|}"
    done
}

[[ ! -d "$GIT_BASE_DIR" ]] && j::die "Git directory not found: $GIT_BASE_DIR"

_process_repo() {
    local repo_dir="$1"
    local repo_name conflicted staged modified untracked behind ahead label
    repo_name="${repo_dir%/}"; repo_name="${repo_name##*/}"

    IFS='|' read -r conflicted staged modified untracked \
        <<< "$(git -C "$repo_dir" status --porcelain 2>/dev/null | _count_states)"
    behind=0; ahead=0
    read -r behind ahead \
        < <(git -C "$repo_dir" rev-list --count --left-right @{upstream}...HEAD 2>/dev/null) || true
    behind="${behind:-0}"; ahead="${ahead:-0}"

    label=$(_build_label "$conflicted" "$staged" "$modified" "$untracked" "$ahead" "$behind")

    case "$(_classify "$conflicted" "$staged" "$modified" "$untracked" "$ahead" "$behind")" in
        conflict) CONFLICT_ENTRIES+=("$repo_name|$label") ;;
        sync)     SYNC_ENTRIES+=("$repo_name|$label")     ;;
        dirty)    DIRTY_ENTRIES+=("$repo_name|$label")    ;;
        clean)    CLEAN_ENTRIES+=("$repo_name|$label")    ;;
    esac
}

CONFLICT_ENTRIES=() SYNC_ENTRIES=() DIRTY_ENTRIES=() CLEAN_ENTRIES=()

for REPO_DIR in "$GIT_BASE_DIR"/*/; do
    [[ -d "$REPO_DIR/.git" ]] || continue
    _process_repo "$REPO_DIR"
done

TOTAL=$(( ${#CONFLICT_ENTRIES[@]} + ${#SYNC_ENTRIES[@]} + ${#DIRTY_ENTRIES[@]} + ${#CLEAN_ENTRIES[@]} ))
[[ "$TOTAL" -eq 0 ]] && j::info "No Git repositories found in: $GIT_BASE_DIR" && exit 0

_print_group "$J_RED"    "${CONFLICT_ENTRIES[@]}"
_print_group "$J_CYAN"   "${SYNC_ENTRIES[@]}"
_print_group "$J_YELLOW" "${DIRTY_ENTRIES[@]}"
_print_group "$J_GREEN"  "${CLEAN_ENTRIES[@]}"
