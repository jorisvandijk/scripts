#!/usr/bin/env bash
#	jBlog 1.0
#	Write and publish a Hugo blog post
#	Dependencies: hugo, zeditor, fzf, git
#	Usage: jBlog
#
#	By Joris van Dijk | Jorisvandijk.com
#	Licensed under the MIT license

source "$(dirname "${BASH_SOURCE[0]}")/j"

[[ "$1" == "--version" || "$1" == "-v" ]] && j::version "$0" && exit 0
[[ "$1" == "--help"    || "$1" == "-h" ]] && j::help "jBlog" && exit 0
[[ -n "$1" ]]                             && j::die "Usage: jBlog (no arguments)"

WEBSITE_DIR="$HOME/git/website"
HUGO_PID=""
TITLE=""
DEST=""
DRAFT_FILE=""

_preflight() {
    j::require hugo git fzf
    command -v zeditor &>/dev/null || j::die "zeditor is not on PATH"
    cd "$WEBSITE_DIR" || j::die "Could not cd to $WEBSITE_DIR"
}

_find_draft() {
    shopt -s nullglob
    local drafts=("$WEBSITE_DIR/content/posts/untitled-"*.md)
    shopt -u nullglob
    [[ ${#drafts[@]} -gt 0 ]] && echo "${drafts[0]}"
}

_create_draft() {
    local timestamp; timestamp="$(date +%Y%m%d%H%M%S)"
    local rel_path="posts/untitled-${timestamp}.md"
    hugo new "$rel_path" >&2 || j::die "Hugo could not create the draft"
    echo "$WEBSITE_DIR/content/$rel_path"
}

_cleanup() {
    [[ -n "$HUGO_PID" ]] && kill "$HUGO_PID" 2>/dev/null
    rm -f "$WEBSITE_DIR/.hugo_build.lock" 2>/dev/null
}

_start_server() {
    local slug; slug="$(basename "$DRAFT_FILE" .md)"
    local url="http://localhost:1313/posts/${slug}/"

    if ! lsof -i :1313 -sTCP:LISTEN &>/dev/null; then
        hugo server -D &>/dev/null &
        HUGO_PID=$!
        j::info "Starting Hugo server..."
    fi

    local attempts=0
    until curl -sf "$url" &>/dev/null; do
        sleep 0.3
        attempts=$((attempts + 1))
        [[ $attempts -gt 60 ]] && j::die "Hugo server failed to start"
    done
    open "$url"
}

_slugify() {
    local title="$1"
    local slug="${title,,}"
    slug="${slug// /-}"
    slug="${slug//[^a-z0-9-]/}"
    echo "$slug"
}

_update_front_matter() {
    local draft_file="$1"
    local title="$2"
    local now; now="$(date "+%Y-%m-%dT%H:%M:%S%z" | sed 's/\([+-][0-9][0-9]\)\([0-9][0-9]\)$/\1:\2/')"
    sed -i '' "s|^title:.*|title: \"${title}\"|" "$draft_file"
    sed -i '' "s|^date:.*|date: ${now}|"         "$draft_file"
    sed -i '' 's/^draft: true/draft: false/'      "$draft_file"
}

_finish_post() {
    local draft_file="$1"
    while [[ -z "$TITLE" ]]; do
        read -r -p "Post title: " TITLE
    done
    local slug; slug="$(_slugify "$TITLE")"
    DEST="$WEBSITE_DIR/content/posts/${slug}.md"
    [[ -e "$DEST" ]] && j::die "A post already exists at ${DEST} — draft preserved at ${draft_file}"
    _update_front_matter "$draft_file" "$TITLE"
    mv "$draft_file" "$DEST"
    j::info "Post saved: $DEST"
}

_select_tags() {
    local existing
    existing="$(grep -h "^tags:" "$WEBSITE_DIR/content/posts/"*.md 2>/dev/null \
        | sed 's/tags: \[//; s/\]//; s/"//g; s/ //g' \
        | tr ',' '\n' | sort -u | grep -v '^$')"

    local chosen=""
    [[ -n "$existing" ]] && chosen="$(echo "$existing" \
        | fzf --multi --prompt="Select tags (Tab toggles, Enter confirms, Esc skips): " \
              --height=~40% --layout=reverse 2>/dev/null)" || chosen=""

    local new_input=""
    read -r -p "New tags (space-separated, Enter to skip): " new_input

    local all_tags=()
    local tag
    while IFS= read -r tag; do
        [[ -n "$tag" ]] && all_tags+=("$tag")
    done <<< "$chosen"
    for tag in $new_input; do
        [[ -n "$tag" ]] && all_tags+=("$tag")
    done

    local tags_str=""
    for tag in "${all_tags[@]}"; do
        tags_str+="\"${tag}\", "
    done
    tags_str="${tags_str%, }"

    sed -i '' "s|^tags:.*|tags: [${tags_str}]|" "$DEST"
    [[ ${#all_tags[@]} -gt 0 ]] && j::info "Tags: ${tags_str}"
}

_push() {
    local push_answer
    read -r -p "Push to git? [Y/n] " push_answer
    [[ "${push_answer,,}" == "n" ]] && return 0
    git add "$DEST" || j::die "Failed to stage post"
    git commit -m "Add post: ${TITLE}" || j::die "Failed to commit post"
    git push || j::die "Failed to push post"
    j::info "Post published"
}

_preflight

DRAFT_FILE="$(_find_draft)"

[[ -z "$DRAFT_FILE" ]] && DRAFT_FILE="$(_create_draft)"

trap _cleanup EXIT

_start_server

j::info "Opening draft in Zed — close the window when done writing"
zeditor --wait "$DRAFT_FILE"

_finish_post "$DRAFT_FILE"
_select_tags
_push
