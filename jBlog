#!/usr/bin/env bash
#	jBlog 3.4
#	Write and publish a Hugo blog post
#	Dependencies: hugo, zeditor, git, fzf
#	Keywords: write, post, article, hugo, publish, draft, blog
#	Usage: jBlog
#
#	By Joris van Dijk | Jorisvandijk.com
#	Licensed under the MIT license

source "$(dirname "${BASH_SOURCE[0]}")/j"

[[ "$1" == "--version" || "$1" == "-v" ]] && j::version "$0" && exit 0
[[ "$1" == "--help"    || "$1" == "-h" ]] && j::help "jBlog" && exit 0
[[ -n "$1" ]]                             && j::die "Usage: jBlog (no arguments)"

WEBSITE_DIR="$HOME/git/website"
HUGO_PID=""
TITLE=""
DEST=""
DRAFT_FILE=""

_preflight() {
    j::require hugo git zeditor
    cd "$WEBSITE_DIR" || j::die "Could not cd to $WEBSITE_DIR"
}

_find_draft() {
    shopt -s nullglob
    local drafts=("$WEBSITE_DIR/content/posts/untitled-"*.md)
    shopt -u nullglob
    [[ ${#drafts[@]} -gt 1 ]] && j::warn "Found ${#drafts[@]} drafts — using oldest; others may need cleanup"
    [[ ${#drafts[@]} -gt 0 ]] && echo "${drafts[0]}"
}

_create_draft() {
    local timestamp rel_path
    printf -v timestamp '%(%Y%m%d%H%M%S)T' -1
    rel_path="posts/untitled-${timestamp}.md"
    hugo new "$rel_path" >&2 || j::die "Hugo could not create the draft"
    printf '%s\n' "$WEBSITE_DIR/content/$rel_path"
}

_cleanup() {
    [[ -n "$HUGO_PID" ]] && kill "$HUGO_PID" 2>/dev/null
    rm -f "$WEBSITE_DIR/.hugo_build.lock" 2>/dev/null
}

_ensure_server() {
    lsof -i :1313 -sTCP:LISTEN &>/dev/null && return 0
    hugo server -D &>/dev/null &
    HUGO_PID=$!
    j::info "Starting Hugo server..."
}

_wait_for_server() {
    local url="$1"
    local attempts=0
    j::info "Waiting for Hugo server..."
    until curl -sf "$url" &>/dev/null; do
        sleep 0.3
        attempts=$((attempts + 1))
        [[ $attempts -gt 60 ]] && j::die "Hugo server failed to start"
    done
    j::info "Server ready."
}

_start_server() {
    local slug; slug="$(basename "$DRAFT_FILE" .md)"
    local url="http://localhost:1313/posts/${slug}/"
    _ensure_server
    _wait_for_server "$url"
    open "$url"
}

_slugify() {
    local title="$1"
    local slug="${title,,}"
    slug="${slug// /-}"
    slug="${slug//[^a-z0-9-]/}"
    echo "$slug"
}

_update_front_matter() {
    local draft_file="$1"
    local title="$2"
    local now tmp
    printf -v now '%(%Y-%m-%dT%H:%M:%S%z)T' -1
    now="${now::-2}:${now: -2}"
    tmp="$(mktemp)"
    while IFS= read -r line; do
        case "$line" in
            title:*)       printf 'title: "%s"\n' "$title" ;;
            date:*)        printf 'date: %s\n' "$now" ;;
            "draft: true") printf 'draft: false\n' ;;
            *)             printf '%s\n' "$line" ;;
        esac
    done < "$draft_file" > "$tmp" && mv "$tmp" "$draft_file"
}

_prompt_title() {
    while [[ -z "$TITLE" ]]; do
        j::prompt "Post title:"
        read -r TITLE
    done
}

_finish_post() {
    local draft_file="$1"
    _prompt_title
    local slug; slug="$(_slugify "$TITLE")"
    DEST="$WEBSITE_DIR/content/posts/${slug}.md"
    [[ -e "$DEST" ]] && j::die "A post already exists at ${DEST} — draft preserved at ${draft_file}"
    _update_front_matter "$draft_file" "$TITLE"
    mv "$draft_file" "$DEST"
    j::info "Post saved: $DEST"
}

_existing_tags() {
    grep -h "^tags:" "$WEBSITE_DIR/content/posts/"*.md 2>/dev/null \
        | sed 's/tags: \[//; s/\]//; s/"//g; s/ //g' \
        | tr ',' '\n' | sort -u | grep -v '^$'
}

_pick_tags() {
    local existing="$1"
    [[ -z "$existing" ]] && return 0
    echo "$existing" | j::pick "Tags" multi
}

_write_tags() {
    local tags_str="$1"
    sed -i '' "s|^tags:.*|tags: [${tags_str}]|" "$DEST"
    j::info "Tags: ${tags_str}"
}

_format_tag_string() {
    local result="" tag
    for tag in "$@"; do
        result+="\"${tag}\", "
    done
    printf '%s' "${result%, }"
}

_select_tags() {
    local chosen; chosen="$(_pick_tags "$(_existing_tags)")"
    local new_input
    j::prompt "New tags (space-separated, Enter to skip):"
    read -r new_input

    local all_tags=() tag
    while IFS= read -r tag; do
        [[ -n "$tag" ]] && all_tags+=("$tag")
    done <<< "$chosen"
    for tag in $new_input; do
        [[ -n "$tag" ]] && all_tags+=("$tag")
    done

    [[ ${#all_tags[@]} -eq 0 ]] && return 0
    _write_tags "$(_format_tag_string "${all_tags[@]}")"
}

_push() {
    j::confirm "Push to git?" N || { j::info "Post saved locally at $DEST — commit and push manually when ready"; return 0; }
    git add "$DEST" || j::die "Failed to stage post"
    git commit -m "Add post: ${TITLE}" || j::die "Failed to commit post"
    git push || j::die "Failed to push post"
    j::info "Post published"
}

_preflight

DRAFT_FILE="$(_find_draft)"

[[ -z "$DRAFT_FILE" ]] && DRAFT_FILE="$(_create_draft)"

trap _cleanup EXIT

_start_server

j::info "Opening draft in Zed — close the window when done writing"
zeditor --wait "$DRAFT_FILE"

_finish_post "$DRAFT_FILE"
_select_tags
_push
