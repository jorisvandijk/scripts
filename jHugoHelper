#!/usr/bin/env bash
#	jHugoHelper 4.1
#	Hugo site helper: server, new post, new microblog
#	Dependencies: hugo
#	Keywords: hugo, website, server, static site, post, preview
#	Usage: jHugoHelper {server|new|microblog} [post-name]
#
#	By Joris van Dijk | Jorisvandijk.com
#	Licensed under the MIT license

source "$(dirname "${BASH_SOURCE[0]}")/j"

[[ "$1" == "--version" || "$1" == "-v" ]] && j::version "$0" && exit 0
[[ "$1" == "--help"    || "$1" == "-h" ]] && j::help "jHugoHelper" && exit 0

[[ -z "$1" ]] && j::die "Usage: jHugoHelper {server|new|microblog} [post-name]"

j::require hugo rm

j::require_vars JVAR_HUGO_SITE_DIR

_enter_website_dir() { cd "$JVAR_HUGO_SITE_DIR" || j::die "Could not cd to $JVAR_HUGO_SITE_DIR"; }

_new_post() {
    local post_name="$1"
    [[ -z "$post_name" ]] && j::die "Post name required - Usage: jHugoHelper new <post-name>"
    _enter_website_dir
    hugo new "posts/${post_name}.md" || j::die "Hugo could not create the post"
    local filepath="content/posts/${post_name}.md"
    j::edit_or_discard "$filepath" || { j::info "No changes - post discarded"; exit 0; }
}

_new_microblog() {
    _enter_website_dir
    local timestamp filepath
    printf -v timestamp '%(%Y-%m-%d-%H%M%S)T' -1
    filepath="content/microblog/${timestamp}.md"
    [[ -e "$filepath" ]] && j::die "Path already exists: ${filepath}"
    hugo new "microblog/${timestamp}.md" || j::die "Hugo could not create the status"
    j::edit_or_discard "$filepath" || { j::info "No changes - microblog discarded"; exit 0; }
}

case "$1" in
    server)
        _enter_website_dir
        trap 'rm -f "$JVAR_HUGO_SITE_DIR/.hugo_build.lock"' EXIT
        hugo server -D
        ;;
    new)    _new_post "${2:-}" ;;
    microblog) _new_microblog ;;
    *)         j::die "Usage: jHugoHelper {server|new|microblog} [post-name]" ;;
esac
