#!/usr/bin/env bash
#	jLxc 1.0
#	Toggle Proxmox LXC containers on/off
#	Dependencies: fzf, ssh
#	Usage: jLxc
#
#	By Joris van Dijk | Jorisvandijk.com
#	Licensed under the MIT license

source "$(dirname "${BASH_SOURCE[0]}")/j"

[[ "$1" == "--version" || "$1" == "-v" ]] && j::version "$0" && exit 0
[[ "$1" == "--help"    || "$1" == "-h" ]] && j::help "jLxc" && exit 0
[[ -n "$1" ]] && j::die "Usage: jLxc (no arguments)"

PROXMOX_HOST="root@192.168.1.5"

_fetch_containers() {
	ssh "$PROXMOX_HOST" "pct list" 2>/dev/null
}

_build_fzf_input() {
	local raw="$1"
	local vmid status name

	while IFS= read -r line; do
		read -r vmid status name _ <<< "$line"
		case "$status" in
			running)
				printf "${J_GREEN}● running${J_RESET}\t%-30s\t%s\trunning\n" "$name" "$vmid"
				;;
			*)
				printf "${J_DIM}○ stopped${J_RESET}\t%-30s\t%s\t${status}\n" "$name" "$vmid"
				;;
		esac
	done < <(tail -n +2 <<< "$raw")
}

_pick_container() {
	local input="$1"
	fzf \
		--ansi \
		--delimiter=$'\t' \
		--with-nth=1,2,3 \
		--prompt="LXC » " \
		--height=60% \
		--reverse \
		--border \
		--header="  STATUS       NAME                            VMID" \
		<<< "$input"
}

_toggle_container() {
	local vmid="$1"
	local status="$2"
	local output
	case "$status" in
		running)
			j::info "Stopping container ${vmid}..."
			output=$(ssh "$PROXMOX_HOST" "pct stop ${vmid}" 2>&1) || j::die "${output:-Failed to stop container ${vmid}}"
			j::info "Container ${vmid} stopped"
			;;
		stopped)
			j::info "Starting container ${vmid}..."
			output=$(ssh "$PROXMOX_HOST" "pct start ${vmid}" 2>&1) || j::die "${output:-Failed to start container ${vmid}}"
			j::info "Container ${vmid} started"
			;;
		*)
			j::die "Cannot toggle container in status: ${status}"
			;;
	esac
}

j::require fzf ssh

RAW=$(_fetch_containers)
[[ -z "$RAW" ]] && j::die "Failed to connect to ${PROXMOX_HOST}"

FZF_INPUT=$(_build_fzf_input "$RAW")
[[ -z "$FZF_INPUT" ]] && j::die "No containers found"

SELECTED=$(_pick_container "$FZF_INPUT")
[[ -z "$SELECTED" ]] && exit 0

VMID=$(cut -f3 <<< "$SELECTED")
STATUS=$(cut -f4 <<< "$SELECTED")

_toggle_container "$VMID" "$STATUS"
