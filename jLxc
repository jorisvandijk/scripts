#!/usr/bin/env bash
#	jLxc 4.1
#	Toggle Proxmox LXC containers on/off
#	Dependencies: fzf, ssh
#	Keywords: lxc, container, proxmox, vm, toggle, start, stop
#	Usage: jLxc
#
#	By Joris van Dijk | Jorisvandijk.com
#	Licensed under the MIT license

source "$(dirname "${BASH_SOURCE[0]}")/j"

[[ "$1" == "--version" || "$1" == "-v" ]] && j::version "$0" && exit 0
[[ "$1" == "--help"    || "$1" == "-h" ]] && j::help "jLxc" && exit 0
[[ -n "$1" ]] && j::die "Usage: jLxc (no arguments)"

j::require_vars JVAR_HOMELAB_ROOT

_fetch_containers() {
    ssh "$JVAR_HOMELAB_ROOT" "pct list" 2>/dev/null
}

_format_container_row() {
    local name="$1" vmid="$2" status="$3"
    case "$status" in
        running) printf "${J_GREEN}● running${J_RESET}\t%-30s\t%s\trunning\n" "$name" "$vmid" ;;
        *)       printf "${J_DIM}○ stopped${J_RESET}\t%-30s\t%s\t${status}\n" "$name" "$vmid" ;;
    esac
}

_build_fzf_input() {
    local raw="$1"
    local lines=() line vmid status name rest
    mapfile -t lines <<< "$raw"
    for line in "${lines[@]:1}"; do
        read -r vmid status name rest <<< "$line"
        _format_container_row "$name" "$vmid" "$status"
    done
}

_pick_container() {
    local input="$1"
    j::pick_table "Container" "1,2,3" single <<< "$input"
}

_toggle_container() {
    local vmid="$1"
    local status="$2"
    local output
    case "$status" in
        running)
            j::info "Stopping container ${vmid}..."
            output=$(ssh "$JVAR_HOMELAB_ROOT" -- pct stop "$vmid" 2>&1) || j::die "${output:-Failed to stop container ${vmid}}"
            j::info "Container ${vmid} stopped"
            ;;
        stopped)
            j::info "Starting container ${vmid}..."
            output=$(ssh "$JVAR_HOMELAB_ROOT" -- pct start "$vmid" 2>&1) || j::die "${output:-Failed to start container ${vmid}}"
            j::info "Container ${vmid} started"
            ;;
        *)
            j::die "Cannot toggle container in status: ${status}"
            ;;
    esac
}

j::require ssh

RAW=$(_fetch_containers)
[[ -z "$RAW" ]] && j::die "Failed to connect to ${JVAR_HOMELAB_ROOT}"

FZF_INPUT=$(_build_fzf_input "$RAW")
[[ -z "$FZF_INPUT" ]] && j::die "No containers found"

SELECTED=$(_pick_container "$FZF_INPUT")
[[ -z "$SELECTED" ]] && exit 0

IFS=$'\t' read -r DISPLAY_STATUS CONTAINER_NAME VMID STATUS <<< "$SELECTED"

_toggle_container "$VMID" "$STATUS"
